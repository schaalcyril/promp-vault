{
  "realm": "prompt-vault",
  "enabled": true,
  "displayName": "Prompt Vault \u2014 K3s local",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "roles": {
    "realm": [
      {
        "name": "user"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "prompt-vault-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://prompt-vault.home.arpa/"
      ],
      "webOrigins": [
        "https://prompt-vault.home.arpa"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://prompt-vault.home.arpa/"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "prompt-vault-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "utilisateur",
      "enabled": true,
      "firstName": "utilisateur",
      "lastName": "Test",
      "email": "utilisateur@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    },
    {
      "username": "administrateur",
      "enabled": true,
      "firstName": "administrateur",
      "lastName": "Test",
      "email": "administrateur@example.test",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_ADMIN_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ]
    }
  ]
}
